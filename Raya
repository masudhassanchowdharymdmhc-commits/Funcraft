<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#a855f7">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Raya">
<meta name="mobile-web-app-capable" content="yes">
<meta name="description" content="Raya — Your personal AI voice assistant">
<title>Raya — Your Personal Assistant</title>

<!-- PWA Manifest -->
<link rel="manifest" href="manifest.json">

<!-- Apple touch icons -->
<link rel="apple-touch-icon" href="icons/icon-192.png">
<link rel="apple-touch-icon" sizes="152x152" href="icons/icon-152.png">
<link rel="apple-touch-icon" sizes="192x192" href="icons/icon-192.png">
<link rel="apple-touch-icon" sizes="512x512" href="icons/icon-512.png">

<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@200;300;400;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root{
  --text:#1d1d1f;--text2:#6e6e73;--text3:#aeaeb2;
  --card:rgba(255,255,255,0.75);--shadow:0 8px 32px rgba(0,0,0,0.10),0 2px 8px rgba(0,0,0,0.05);
  --shadow2:0 20px 60px rgba(0,0,0,0.14),0 4px 16px rgba(0,0,0,0.07);
  --r:24px;--r2:18px;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;font-family:'Nunito',sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased;}

/* ── SIRI CANVAS ── */
#siri-canvas{position:fixed;inset:0;z-index:0;width:100%;height:100%;display:block;}
.bg-overlay{position:fixed;inset:0;z-index:1;background:rgba(255,255,255,0.20);pointer-events:none;}

/* ── INSTALL BANNER ── */
#install-banner{
  position:fixed;top:0;left:0;right:0;z-index:200;
  background:linear-gradient(135deg,#a855f7,#06b6d4);
  color:white;padding:14px 18px;
  display:none;align-items:center;gap:12px;
  box-shadow:0 4px 20px rgba(168,85,247,0.4);
  animation:slideDown 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes slideDown{from{transform:translateY(-100%);}to{transform:translateY(0);}}
#install-banner.show{display:flex;}
.ib-icon{font-size:1.8rem;flex-shrink:0;}
.ib-text{flex:1;}
.ib-title{font-weight:800;font-size:0.9rem;}
.ib-sub{font-size:0.72rem;opacity:0.85;margin-top:1px;font-weight:600;}
.ib-btn{background:white;color:#a855f7;border:none;border-radius:50px;padding:8px 16px;font-weight:800;font-size:0.8rem;cursor:pointer;flex-shrink:0;transition:transform 0.15s;}
.ib-btn:active{transform:scale(0.94);}
.ib-close{background:none;border:none;color:rgba(255,255,255,0.8);font-size:1.1rem;cursor:pointer;padding:4px;flex-shrink:0;}

/* ── OFFLINE BANNER ── */
#offline-banner{
  position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(20px);
  z-index:200;background:rgba(30,30,30,0.92);color:white;
  padding:10px 20px;border-radius:50px;font-size:0.78rem;font-weight:700;
  opacity:0;transition:all 0.3s;white-space:nowrap;
  backdrop-filter:blur(14px);
}
#offline-banner.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ── LISTENING FULLSCREEN ── */
#listen-screen{
  position:fixed;inset:0;z-index:50;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:0;
  pointer-events:none;opacity:0;transition:opacity 0.35s;
  background:rgba(0,0,0,0.08);backdrop-filter:blur(2px);
}
#listen-screen.show{opacity:1;pointer-events:all;}
.ls-logo{font-size:1.1rem;font-weight:900;letter-spacing:0.2em;text-transform:uppercase;color:white;text-shadow:0 2px 10px rgba(0,0,0,0.2);margin-bottom:30px;opacity:0.9;}
.ls-wave{display:flex;align-items:flex-end;justify-content:center;gap:5px;height:90px;margin-bottom:28px;}
.ls-bar{width:5px;border-radius:3px;background:linear-gradient(to top,rgba(255,255,255,0.5),white);animation:lsBar 0.7s ease-in-out infinite;}
.ls-bar:nth-child(1){height:14px;animation-delay:0.00s;}
.ls-bar:nth-child(2){height:28px;animation-delay:0.07s;}
.ls-bar:nth-child(3){height:48px;animation-delay:0.14s;}
.ls-bar:nth-child(4){height:68px;animation-delay:0.21s;}
.ls-bar:nth-child(5){height:82px;animation-delay:0.28s;}
.ls-bar:nth-child(6){height:90px;animation-delay:0.35s;}
.ls-bar:nth-child(7){height:78px;animation-delay:0.42s;}
.ls-bar:nth-child(8){height:58px;animation-delay:0.49s;}
.ls-bar:nth-child(9){height:38px;animation-delay:0.56s;}
.ls-bar:nth-child(10){height:20px;animation-delay:0.63s;}
@keyframes lsBar{0%,100%{transform:scaleY(0.35);opacity:0.45;}50%{transform:scaleY(1.15);opacity:1;}}
.ls-label{color:white;font-size:1.15rem;font-weight:800;text-shadow:0 2px 12px rgba(0,0,0,0.22);margin-bottom:8px;}
.ls-sub{color:rgba(255,255,255,0.75);font-size:0.8rem;font-weight:600;margin-bottom:32px;}
.ls-transcript{
  min-height:32px;max-width:80%;text-align:center;
  color:white;font-size:1rem;font-weight:700;
  text-shadow:0 2px 10px rgba(0,0,0,0.25);
  padding:0 20px;letter-spacing:0.01em;
  margin-bottom:24px;
}
.ls-cancel{
  background:rgba(255,255,255,0.2);border:1.5px solid rgba(255,255,255,0.4);
  border-radius:50px;padding:13px 36px;
  color:white;font-family:'Nunito',sans-serif;font-size:0.9rem;font-weight:800;
  cursor:pointer;backdrop-filter:blur(10px);
  transition:background 0.2s,transform 0.15s;
}
.ls-cancel:hover{background:rgba(255,255,255,0.32);}
.ls-cancel:active{transform:scale(0.95);}

/* ── TOAST ── */
.toast{position:fixed;top:70px;left:50%;transform:translateX(-50%) translateY(-16px);background:rgba(25,25,30,0.92);color:white;font-size:0.8rem;font-weight:700;padding:10px 22px;border-radius:50px;z-index:9999;opacity:0;transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1);backdrop-filter:blur(14px);white-space:nowrap;max-width:88vw;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

/* ── APP ── */
.app{position:relative;z-index:10;max-width:430px;margin:0 auto;min-height:100vh;padding:0 0 130px;display:flex;flex-direction:column;}

/* STATUS */
.status-bar{display:flex;align-items:center;justify-content:space-between;padding:14px 24px 0;font-size:0.75rem;font-weight:700;color:var(--text);}
.status-time{font-size:1rem;font-weight:800;}
.status-icons{display:flex;gap:6px;align-items:center;}
.pwa-badge{font-size:0.56rem;background:linear-gradient(135deg,#a855f7,#06b6d4);color:white;padding:2px 7px;border-radius:50px;font-weight:800;letter-spacing:0.06em;}

/* HEADER */
header{padding:16px 24px 10px;display:flex;align-items:center;justify-content:space-between;}
.header-title{font-size:2.2rem;font-weight:900;letter-spacing:-0.04em;background:linear-gradient(135deg,#a855f7 0%,#06b6d4 55%,#f43f5e 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;}
.header-sub{font-size:0.74rem;color:var(--text2);font-weight:600;margin-top:2px;}
.hdr-row{display:flex;gap:8px;}
.hdr-btn{width:36px;height:36px;border-radius:50%;background:var(--card);border:1px solid rgba(255,255,255,0.9);box-shadow:var(--shadow);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:0.95rem;transition:transform 0.2s;backdrop-filter:blur(12px);}
.hdr-btn:hover{transform:scale(1.1);}
.hdr-btn:active{transform:scale(0.92);}

/* ORB CARD */
.raya-card{margin:8px 16px;background:var(--card);border:1px solid rgba(255,255,255,0.92);border-radius:36px;padding:24px 20px 20px;display:flex;flex-direction:column;align-items:center;box-shadow:var(--shadow2);backdrop-filter:blur(24px) saturate(180%);-webkit-backdrop-filter:blur(24px) saturate(180%);position:relative;overflow:hidden;}
.raya-card::before{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(145deg,rgba(168,85,247,0.05),rgba(6,182,212,0.04));pointer-events:none;}

/* ORB */
.orb-wrap{position:relative;width:130px;height:130px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
.orb-halo{position:absolute;inset:-22px;border-radius:50%;background:conic-gradient(from 0deg,#a855f7,#06b6d4,#f43f5e,#ff9f0a,#a855f7);opacity:0;filter:blur(20px);animation:haloB 3s ease-in-out infinite;}
@keyframes haloB{0%,100%{opacity:0.18;transform:scale(0.88);}50%{opacity:0.38;transform:scale(1.12);}}
.orb-r1,.orb-r2,.orb-r3{position:absolute;border-radius:50%;border:1.5px solid transparent;animation:ringP 3s ease-in-out infinite;}
.orb-r1{inset:-14px;border-color:rgba(168,85,247,0.22);animation-delay:0s;}
.orb-r2{inset:-28px;border-color:rgba(6,182,212,0.16);animation-delay:0.5s;}
.orb-r3{inset:-42px;border-color:rgba(244,63,94,0.10);animation-delay:1s;}
@keyframes ringP{0%,100%{transform:scale(1);opacity:0.7;}50%{transform:scale(1.05);opacity:1;}}
.orb{position:relative;z-index:2;width:112px;height:112px;border-radius:50%;background:linear-gradient(135deg,#a855f7 0%,#7c3aed 35%,#06b6d4 70%,#0891b2 100%);box-shadow:0 0 0 3px rgba(255,255,255,0.92),0 14px 44px rgba(168,85,247,0.38),0 4px 14px rgba(0,0,0,0.10);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform 0.22s cubic-bezier(0.34,1.56,0.64,1);user-select:none;overflow:hidden;}
.orb:hover{transform:scale(1.05);}.orb:active{transform:scale(0.95);}
.orb.listening{background:linear-gradient(135deg,#f43f5e,#e11d48,#ff7c5e);box-shadow:0 0 0 3px rgba(255,255,255,0.92),0 14px 44px rgba(244,63,94,0.42);animation:orbL 1s ease-in-out infinite;}
.orb.thinking{animation:orbT 1.6s linear infinite;}
@keyframes orbL{0%,100%{transform:scale(1);}50%{transform:scale(1.07);}}
@keyframes orbT{0%{filter:hue-rotate(0deg);}100%{filter:hue-rotate(360deg);}}
.orb-inner{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;}
.orb-mw{display:flex;gap:3px;align-items:center;opacity:0;transition:opacity 0.3s;}
.orb-mw.show{opacity:1;}
.mwb{width:3px;border-radius:2px;background:rgba(255,255,255,0.9);animation:mwbA 0.8s ease-in-out infinite;}
.mwb:nth-child(1){height:10px;animation-delay:0.00s;}.mwb:nth-child(2){height:22px;animation-delay:0.08s;}.mwb:nth-child(3){height:34px;animation-delay:0.16s;}.mwb:nth-child(4){height:26px;animation-delay:0.24s;}.mwb:nth-child(5){height:38px;animation-delay:0.32s;}.mwb:nth-child(6){height:20px;animation-delay:0.40s;}.mwb:nth-child(7){height:12px;animation-delay:0.48s;}
@keyframes mwbA{0%,100%{transform:scaleY(0.4);opacity:0.6;}50%{transform:scaleY(1.2);opacity:1;}}
.orb-face{position:absolute;font-size:2.1rem;transition:opacity 0.3s;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.18));}
.raya-name{font-size:0.66rem;font-weight:800;letter-spacing:0.22em;text-transform:uppercase;color:var(--text2);margin-bottom:3px;}
.raya-status{font-size:1rem;font-weight:700;color:var(--text);text-align:center;min-height:24px;transition:all 0.3s;}
.raya-status.listening{color:#f43f5e;}.raya-status.thinking{color:#06b6d4;}
.tap-hint{font-size:0.68rem;color:var(--text3);margin-top:4px;font-weight:600;}

/* CHAT */
.chat-area{margin:0 16px 6px;max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;scroll-behavior:smooth;scrollbar-width:none;}
.chat-area::-webkit-scrollbar{display:none;}
.bubble{max-width:84%;padding:11px 16px;border-radius:20px;font-size:0.87rem;line-height:1.5;font-weight:600;animation:bubIn 0.32s cubic-bezier(0.34,1.56,0.64,1);}
@keyframes bubIn{from{opacity:0;transform:scale(0.84) translateY(8px);}to{opacity:1;transform:scale(1) translateY(0);}}
.bubble.user{align-self:flex-end;background:linear-gradient(135deg,#007aff,#5e5ce6);color:white;border-bottom-right-radius:5px;box-shadow:0 4px 16px rgba(0,122,255,0.24);}
.bubble.raya{align-self:flex-start;background:rgba(255,255,255,0.90);color:var(--text);border-bottom-left-radius:5px;box-shadow:0 4px 16px rgba(0,0,0,0.07);border:1px solid rgba(0,0,0,0.05);backdrop-filter:blur(10px);}
.bubble.raya b{color:#a855f7;}

/* INPUT */
.input-row{margin:6px 16px 10px;display:flex;gap:8px;align-items:center;}
.text-input{flex:1;background:rgba(255,255,255,0.88);border:1.5px solid rgba(0,0,0,0.07);border-radius:50px;padding:12px 20px;font-family:'Nunito',sans-serif;font-size:0.88rem;font-weight:600;color:var(--text);outline:none;box-shadow:0 2px 12px rgba(0,0,0,0.05);transition:border-color 0.2s,box-shadow 0.2s;backdrop-filter:blur(10px);}
.text-input:focus{border-color:rgba(168,85,247,0.45);box-shadow:0 2px 12px rgba(168,85,247,0.14);}
.text-input::placeholder{color:var(--text3);font-weight:500;}
.send-btn{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#a855f7,#06b6d4);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.15rem;color:white;box-shadow:0 4px 14px rgba(168,85,247,0.36);transition:transform 0.18s,box-shadow 0.18s;flex-shrink:0;}
.send-btn:hover{transform:scale(1.08);box-shadow:0 6px 22px rgba(168,85,247,0.48);}.send-btn:active{transform:scale(0.93);}

/* SECTION */
.sec{padding:4px 24px 7px;font-size:0.60rem;font-weight:900;letter-spacing:0.16em;text-transform:uppercase;color:var(--text2);}

/* QUICK GRID */
.qgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin:0 16px 8px;}
.qcard{background:var(--card);border:1px solid rgba(255,255,255,0.92);border-radius:var(--r2);padding:12px 13px;cursor:pointer;display:flex;align-items:center;gap:10px;box-shadow:var(--shadow);transition:transform 0.18s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.18s;backdrop-filter:blur(14px);user-select:none;}
.qcard:hover{transform:scale(1.03);box-shadow:var(--shadow2);}.qcard:active{transform:scale(0.96);}
.qc-ico{width:38px;height:38px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.15rem;flex-shrink:0;}
.qc-lbl{font-size:0.78rem;font-weight:800;color:var(--text);}.qc-sub{font-size:0.64rem;font-weight:600;color:var(--text2);margin-top:1px;}

/* APP PILLS */
.apps-scroll{display:flex;gap:10px;overflow-x:auto;padding:0 16px 4px;scrollbar-width:none;}
.apps-scroll::-webkit-scrollbar{display:none;}
.app-pill{flex-shrink:0;background:var(--card);border:1px solid rgba(255,255,255,0.92);border-radius:50px;padding:9px 15px;cursor:pointer;display:flex;align-items:center;gap:7px;box-shadow:var(--shadow);transition:transform 0.18s cubic-bezier(0.34,1.56,0.64,1);user-select:none;white-space:nowrap;backdrop-filter:blur(14px);}
.app-pill:hover{transform:scale(1.05);}.app-pill:active{transform:scale(0.94);}
.ap-ico{font-size:1rem;}.ap-name{font-size:0.77rem;font-weight:800;color:var(--text);}

/* MOBILE CONTROLS */
.mob-panel{margin:6px 16px;background:var(--card);border:1px solid rgba(255,255,255,0.92);border-radius:var(--r);padding:16px 16px 14px;box-shadow:var(--shadow);backdrop-filter:blur(20px);}
.mp-title{font-size:0.62rem;font-weight:900;letter-spacing:0.14em;text-transform:uppercase;color:var(--text2);margin-bottom:12px;}
.ctrl-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.ctrl-ico{font-size:0.9rem;width:20px;text-align:center;flex-shrink:0;}
.ctrl-sl{flex:1;-webkit-appearance:none;appearance:none;height:5px;border-radius:3px;outline:none;cursor:pointer;transition:height 0.15s;}
.ctrl-sl:hover{height:7px;}
.ctrl-sl::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:white;box-shadow:0 1px 8px rgba(0,0,0,0.20);cursor:pointer;}
.ctrl-sl.br{background:linear-gradient(to right,#ffd700 70%,#f0f0f0 70%);}
.ctrl-sl.vo{background:linear-gradient(to right,#a855f7 50%,#e0e0f0 50%);}
.ctrl-val{font-size:0.68rem;font-weight:800;color:var(--text2);min-width:30px;text-align:right;}
.tog-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;}
.tog{display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 3px;background:rgba(0,0,0,0.05);border-radius:14px;border:none;cursor:pointer;transition:all 0.18s cubic-bezier(0.34,1.56,0.64,1);user-select:none;}
.tog.on{background:linear-gradient(135deg,#007aff,#5e5ce6);box-shadow:0 4px 14px rgba(0,122,255,0.30);}
.tog:active{transform:scale(0.90);}
.tog-ico{font-size:1.1rem;}.tog-lbl{font-size:0.52rem;font-weight:800;color:var(--text2);letter-spacing:0.02em;text-align:center;line-height:1.2;}
.tog.on .tog-lbl{color:white;}
.act-row{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px;}
.act{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 3px;background:rgba(0,0,0,0.05);border-radius:14px;border:none;cursor:pointer;transition:all 0.18s cubic-bezier(0.34,1.56,0.64,1);user-select:none;}
.act:hover{background:rgba(168,85,247,0.12);transform:scale(1.04);}.act:active{transform:scale(0.93);}
.act-ico{font-size:1.15rem;}.act-lbl{font-size:0.58rem;font-weight:800;color:var(--text2);}

/* SPEAK CTA */
.speak-cta{margin:8px 16px 14px;padding:14px 20px;background:linear-gradient(135deg,#a855f7 0%,#7c3aed 45%,#06b6d4 100%);border-radius:28px;display:flex;align-items:center;justify-content:center;gap:12px;cursor:pointer;border:none;box-shadow:0 8px 28px rgba(168,85,247,0.38),0 2px 8px rgba(0,0,0,0.06);transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1),box-shadow 0.2s;user-select:none;}
.speak-cta:hover{transform:scale(1.02);box-shadow:0 12px 36px rgba(168,85,247,0.48);}.speak-cta:active{transform:scale(0.97);}
.sc-ico{font-size:1.4rem;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.2));}
.sc-main{color:white;font-weight:800;font-size:0.98rem;letter-spacing:-0.01em;}
.sc-sub{color:rgba(255,255,255,0.72);font-size:0.68rem;font-weight:600;}

/* DOCK */
.dock{position:fixed;bottom:0;left:0;right:0;z-index:100;max-width:430px;margin:0 auto;padding:12px 16px 26px;background:rgba(255,255,255,0.75);backdrop-filter:blur(28px) saturate(200%);-webkit-backdrop-filter:blur(28px) saturate(200%);border-top:1px solid rgba(0,0,0,0.06);display:flex;justify-content:space-around;align-items:center;}
.dock-btn{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;border:none;background:none;padding:5px 10px;border-radius:14px;transition:all 0.18s cubic-bezier(0.34,1.56,0.64,1);user-select:none;}
.dock-btn:active{transform:scale(0.86);}.dock-btn.active{background:rgba(168,85,247,0.12);}
.d-ico{font-size:1.25rem;}.d-lbl{font-size:0.54rem;font-weight:800;color:var(--text2);letter-spacing:0.04em;}
.dock-btn.active .d-lbl{color:#a855f7;}

/* TYPING */
.typing-dots{display:inline-flex;gap:4px;align-items:center;padding:2px 0;}
.typing-dot{width:7px;height:7px;border-radius:50%;background:#a855f7;animation:typB 1.2s infinite;}
.typing-dot:nth-child(2){animation-delay:0.2s;}.typing-dot:nth-child(3){animation-delay:0.4s;}
@keyframes typB{0%,80%,100%{transform:scale(0.7);opacity:0.5;}40%{transform:scale(1);opacity:1;}}

/* PWA INSTALL STEP GUIDE */
.install-guide{margin:6px 16px;background:linear-gradient(135deg,rgba(168,85,247,0.08),rgba(6,182,212,0.06));border:1px solid rgba(168,85,247,0.18);border-radius:var(--r2);padding:14px 16px;display:none;}
.install-guide.show{display:block;}
.ig-title{font-size:0.72rem;font-weight:900;letter-spacing:0.1em;text-transform:uppercase;color:#a855f7;margin-bottom:10px;}
.ig-step{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;font-size:0.8rem;font-weight:600;color:var(--text2);}
.ig-num{width:22px;height:22px;border-radius:50%;background:#a855f7;color:white;display:flex;align-items:center;justify-content:center;font-size:0.65rem;font-weight:900;flex-shrink:0;margin-top:1px;}
.ig-close{float:right;background:none;border:none;color:var(--text3);cursor:pointer;font-size:1rem;line-height:1;}

@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
.ani{animation:fadeUp 0.44s cubic-bezier(0.23,1,0.32,1) both;}
.ani:nth-child(1){animation-delay:0.04s;}.ani:nth-child(2){animation-delay:0.08s;}.ani:nth-child(3){animation-delay:0.12s;}.ani:nth-child(4){animation-delay:0.16s;}.ani:nth-child(5){animation-delay:0.20s;}

@media(min-width:431px){.dock{left:50%;transform:translateX(-50%);right:auto;width:430px;}#install-banner{max-width:430px;left:50%;transform:translateX(-50%);}}
